# ------------------------------------------------------------- credentials
# This repository is public. The FEC key is read-only against public data, but
# it is still a credential: in CI it is an encrypted Actions secret, locally it
# lives in fec_key.txt, and it is never in the tree.
fec_key.txt
*_key.txt
*.pem
*.key
.env
.env.*

